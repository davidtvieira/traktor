# Required: Traktor will not start without these five
TRAKT_CLIENT_ID=
TRAKT_REDIRECT_URI=https://just-copy.me
PORT=7100

# Required: AIOStreams login, only used to fetch your users
AIOSTREAMS_URL=http://192.168.1.4:3000
AIOSTREAMS_UUID=
AIOSTREAMS_PASSWORD=

# Optional
ADMIN_PASSWORD=
ADDON_SECRET=

# Optional: the address AIOStreams and your phone use to reach Traktor (for the lists and calendar addresses)
PUBLIC_URL=
